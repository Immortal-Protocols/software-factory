# Copy to .env, fill every REPLACE value, and chmod 600 .env.
# Generate new secrets for your own local installation. Never reuse live values.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:d4777e9163de0861c3f02ea9e67632b0afadc6d6ebac2cf4c09c00f1317f4a6d
BUZZ_DOMAIN=localhost:3000
RELAY_URL=ws://localhost:3000
BUZZ_MEDIA_BASE_URL=http://localhost:3000
BUZZ_MEDIA_SERVER_DOMAIN=localhost:3000
BUZZ_CORS_ORIGINS=http://localhost:3000
BUZZ_REQUIRE_AUTH_TOKEN=false
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
BUZZ_ALLOW_NIP_OA_AUTH=false
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
BUZZ_PUSH_ENABLED=false
BUZZ_RELAY_PRIVATE_KEY=REPLACE_WITH_NEW_32_BYTE_HEX_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path
BUZZ_HTTP_PORT=3000
RUST_LOG=info
